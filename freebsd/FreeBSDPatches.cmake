include_guard(GLOBAL)

set(ZWWM_PLATFORM "auto" CACHE STRING "Target platform: auto, linux or freebsd")
set_property(CACHE ZWWM_PLATFORM PROPERTY STRINGS auto linux freebsd)

set(_zwwm_platform "${ZWWM_PLATFORM}")
if(_zwwm_platform STREQUAL "auto")
  if(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
    set(_zwwm_platform freebsd)
  else()
    set(_zwwm_platform linux)
  endif()
endif()
if(NOT _zwwm_platform MATCHES "^(linux|freebsd)$")
  message(FATAL_ERROR "ZWWM_PLATFORM must be auto, linux or freebsd")
endif()
if(_zwwm_platform STREQUAL "freebsd")
  set(ZWWM_FREEBSD ON)
else()
  set(ZWWM_FREEBSD OFF)
endif()
if(ZWWM_FREEBSD AND NOT CMAKE_SYSTEM_NAME STREQUAL "FreeBSD" OR
   NOT ZWWM_FREEBSD AND CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
  message(FATAL_ERROR "ZWWM_PLATFORM=${_zwwm_platform} does not match ${CMAKE_SYSTEM_NAME}")
endif()

get_filename_component(ZWWM_FREEBSD_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(zwwm_freebsd_patch target)
  if(NOT ZWWM_FREEBSD)
    return()
  endif()
  find_program(ZWWM_PATCH patch REQUIRED)
  get_target_property(sources ${target} SOURCES)
  get_target_property(source_dir ${target} SOURCE_DIR)
  set(result)
  foreach(src IN LISTS sources)
    get_filename_component(abs "${src}" ABSOLUTE BASE_DIR "${source_dir}")
    file(RELATIVE_PATH rel "${ZWWM_FREEBSD_ROOT}" "${abs}")
    string(REPLACE "/src/" "-" name "${rel}")
    string(REPLACE "/" "-" name "${name}")
    string(REGEX REPLACE "\\.cpp$" "" name "${name}")
    set(patch "${ZWWM_FREEBSD_ROOT}/freebsd/patches/${name}.patch")
    if(src MATCHES "\\.cpp$" AND EXISTS "${patch}")
      set(out "${CMAKE_CURRENT_BINARY_DIR}/freebsd/${name}.cpp")
      add_custom_command(OUTPUT "${out}"
        COMMAND "${ZWWM_PATCH}" -s -f -o "${out}" "${abs}" -i "${patch}"
        DEPENDS "${abs}" "${patch}" VERBATIM)
      list(APPEND result "${out}")
      get_filename_component(dir "${abs}" DIRECTORY)
      target_include_directories(${target} PRIVATE "${dir}")
    else()
      list(APPEND result "${src}")
    endif()
  endforeach()
  set_property(TARGET ${target} PROPERTY SOURCES "${result}")
endfunction()

# FreeBSD < 15 has no native inotify; devel/libinotify provides it.
function(zwwm_freebsd_inotify target)
  if(NOT ZWWM_FREEBSD)
    return()
  endif()
  include(CheckSymbolExists)
  check_symbol_exists(inotify_init1 "sys/inotify.h" ZWWM_NATIVE_INOTIFY)
  if(NOT ZWWM_NATIVE_INOTIFY)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(LIBINOTIFY REQUIRED IMPORTED_TARGET libinotify)
    target_link_libraries(${target} PRIVATE PkgConfig::LIBINOTIFY)
  endif()
endfunction()
