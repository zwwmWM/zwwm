protocol zwwm_layout_manager_v1;

copyright R"(
Copyright 2026 binarylinuxx. SPDX-License-Identifier: BSD-3-Clause
)";

/// external layout ownership
///
/// One provider owns tiled placement for all outputs and active tags. Popups,
/// floating dialogs, floating geometry, and interactive move/resize remain
/// compositor-owned. Provider loss restores built-in tiled layouts.
interface zwwm_layout_manager_v1 version 1 {
  request ~destroy();
  request create_provider(new<zwwm_layout_provider_v1> id);
}

/// versioned placement batches
///
/// Each request identifies output, tag, work area, and participating windows,
/// excluding floating windows and popups. Tiled fullscreen windows retain a slot but display
/// at compositor-controlled fullscreen geometry. Rectangles describe outer
/// frames in global logical coordinates. Commit must place every participant
/// exactly once. New requests invalidate old serials for that output/tag.
/// While waiting, last accepted placements remain visible; new windows use
/// provisional geometry. The compositor never blocks on a layout client.
interface zwwm_layout_provider_v1 version 1 {
  request ~destroy();
  request request_layout();
  request place(uint serial, uint window_hi, uint window_lo, int x, int y, uint width, uint height);

  /// apply a complete batch
  ///
  /// Animate is 0 for interactive updates and 1 for animated reflows.
  /// Failed or stale commits leave the last accepted layout unchanged.
  request commit(uint serial, uint animate);

  event request(
    uint serial,
    uint output_hi,
    uint output_lo,
    uint tag,
    int x,
    int y,
    uint width,
    uint height,
    uint window_count
  );
  event window(
    uint serial,
    uint id_hi,
    uint id_lo,
    uint state,
    string app_id,
    string title,
    uint parent_hi,
    uint parent_lo,
    int x,
    int y,
    uint width,
    uint height,
    int min_width,
    int min_height,
    int max_width,
    int max_height
  );
  event done(uint serial);
  event applied(uint serial);
  event failed(uint serial, string message);
}
