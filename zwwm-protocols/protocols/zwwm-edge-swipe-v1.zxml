/// compositor-owned touch edge swipes
///
/// Lets a shell follow touch swipes that start at an output edge. The
/// compositor recognises the swipe and keeps the touch sequence away from
/// other clients; the shell only animates and decides what the swipe does.
interface zwwm_edge_swipe_manager_v1 version 1 {
  [[bitfield]] enum edge {
    top = 1,
    bottom = 2,
    left = 4,
    right = 8,
  }

  request ~destroy();

  /// listen for swipes from the given edges
  ///
  /// Touches that start within the configured edge zone of any edge in
  /// `edges` become swipes delivered to this object instead of clients.
  request get_edge_swipe(new<zwwm_edge_swipe_v1> id, uint<edge> edges);
}

/// edge swipe events
///
/// Each swipe is one began event, any number of progress events, then
/// exactly one ended event. Offsets are logical pixels from the touch-down
/// point, positive towards the inside of the output for the swipe's edge.
interface zwwm_edge_swipe_v1 version 1 {
  request ~destroy();
  request set_edges(uint<zwwm_edge_swipe_manager_v1.edge> edges);

  event began(
    uint time,                                   ///< milliseconds
    object<wl_output>? output,
    uint<zwwm_edge_swipe_manager_v1.edge> edge,
    fixed x,                                     ///< output-local touch-down position
    fixed y
  );
  event progress(
    uint time,
    fixed distance,  ///< offset along the swipe direction
    fixed lateral    ///< offset across the swipe direction
  );
  event ended(
    uint time,
    fixed distance,
    fixed lateral,
    fixed velocity,  ///< logical pixels per second along the swipe
    uint cancelled   ///< 1 when the touch was cancelled
  );
}
