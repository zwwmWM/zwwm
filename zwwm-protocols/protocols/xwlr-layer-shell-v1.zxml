/// zwwm layer-shell companion extension
///
/// This optional global augments a zwwm_layer_surface_v1.
interface xwlr_layer_shell_v1 version 1 {
  enum error {
    invalid_layer_surface = 0,  ///< object is not this client's zwwm layer surface
    extension_exists = 1,       ///< layer surface already has an extension
  }

  request get_layer_surface(new<xwlr_layer_surface_v1> id, object<zwwm_layer_surface_v1> layer_surface);
  request ~destroy();
}

/// double-buffered optional layer hints
///
/// State takes effect atomically with the associated wl_surface commit. Priority is in the signed 16-bit range [-32768, 32767]. Opacity is a wl_fixed value in [0, 1].
interface xwlr_layer_surface_v1 version 1 {
  enum edge {
    none = 0,
    top = 1,
    bottom = 2,
    left = 4,
    right = 8,
  }

  enum error {
    invalid_exclusive_edge = 0,
    invalid_priority = 1,
    invalid_opacity = 2,
    invalid_surface_state = 3,
  }

  enum report_code {
    exclusive_zone_ignored = 0,
  }

  request set_exclusive_edge(uint<edge> edge);
  request set_priority(int priority);
  request set_opacity(fixed opacity);
  request ~destroy();

  event report(uint<report_code> code, string message);
}
