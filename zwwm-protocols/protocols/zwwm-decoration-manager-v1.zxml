protocol zwwm_decoration_manager_v1;

copyright R"(
SPDX-FileCopyrightText: 2026 binarylinuxx
SPDX-License-Identifier: BSD-3-Clause
)";

/// zwwm surface decoration policy
///
/// Reports the compositor's preferred decoration mode. Clients use this
/// information to enable or disable their titlebars, borders, and shadows.
/// The compositor controls the selected mode and may reject a preference.
/// This protocol is independent of KDE server-decoration. Clients should
/// select either this protocol or xdg-decoration for an individual surface.
interface zwwm_decoration_manager_v1 version 1 {
  enum mode {
    client_side = 1,  ///< client draws decorations
    server_side = 2,  ///< compositor draws decorations
  }

  enum error {
    invalid_surface = 0,  ///< surface is not a live client-owned wl_surface
  }

  /// create a surface decoration policy object
  ///
  /// The compositor sends configure immediately after creation. A client
  /// must disable its own decorations when server_side is selected and
  /// apply that choice on its next surface commit. Destroying the manager
  /// does not destroy existing surface decoration objects.
  request get_decoration(new<zwwm_surface_decoration_v1> id, object<wl_surface> surface);

  request ~destroy();

  /// preferred mode for newly created surfaces
  ///
  /// Sent immediately after binding. It lets clients choose decorations
  /// before constructing or mapping their windows. Per-surface configure
  /// events are authoritative if they differ from this default.
  event default_mode(uint<mode> mode);
}

interface zwwm_surface_decoration_v1 version 1 {
  enum error {
    invalid_mode = 0,  ///< unknown decoration mode
  }

  /// request a decoration mode
  ///
  /// The compositor replies with configure containing its selected mode,
  /// even if it rejects the requested preference. Requests do not require
  /// an xdg_toplevel and may be made before mapping the wl_surface.
  request set_mode(uint<zwwm_decoration_manager_v1.mode> mode);

  request ~destroy();

  event configure(uint<zwwm_decoration_manager_v1.mode> mode);
}
